# Database (PostgreSQL required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/i9portal"

# Admin auth — Google + Microsoft Entra OAuth via NextAuth.
# The AdminUser table acts as the email allowlist; only listed emails may
# sign in. When the table is empty, the first OAuth signer is auto-added as
# the bootstrap admin.
NEXTAUTH_SECRET=""               # openssl rand -base64 32
NEXTAUTH_URL=""                  # e.g. https://open-i9-production.up.railway.app

# Google OAuth (optional — leave blank to hide the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID / Azure AD (optional — leave blank to hide the MS button)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="common"   # or your tenant GUID

# PII Encryption — encrypts sensitive fields (SSN, address, DOB, etc.) at rest
# REQUIRED — generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=""

# Email — Resend (preferred)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Email — SMTP fallback (used if RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# File Storage
STORAGE_PROVIDER="local"    # local | s3
# Where local-storage files live. Defaults to ./public (so dev uploads land
# in ./public/uploads). In Railway, point at a mounted volume — e.g. /data —
# so files survive redeploys.
STORAGE_ROOT=""

# S3 / Cloudflare R2
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Accounting Integrations ---
# Credentials are configured via the Admin > Integrations page.
# No env vars needed — client IDs/secrets are stored encrypted in the database.
# Token encryption keys are derived from DATA_ENCRYPTION_KEY automatically.
